<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SDET Learning Suite">
  <test name="Smoke Tests">
    <groups>
      <run>
        <include name="smoke"/>
      </run>
    </groups>
    <classes>
      <class name="com.raghul.sdet.CalculatorTngTest"/>
      <class name="com.raghul.sdet.BankAccountTngTest"/>
    </classes>
  </test>
    <test name="Regression Tests">
    <groups>
      <run>
        <include name="regression"/>
      </run>
    </groups>
    <classes>
      <class name="com.raghul.sdet.CalculatorTngTest"/>
      <class name="com.raghul.sdet.BankAccountTngTest"/>
    </classes>
  </test>
</suite>